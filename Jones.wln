OpticalAxisAnalysis[d, Quantity[Interval[{1.15, 1.5}], "Terahertz"]];
%[["Eigenpolarizations", All, {"JonesVector", "AzimuthDeg"}]] // TableView 

%-------------------------------------------------------------------------%
Type: Output

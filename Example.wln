*)((*BB[*)("DeconvolveTraces[sample, reference] returns a time trace whose TD2FD spectrum is the regularized sample/reference transmission. \"Threshold\" sets the regularization strength.")(*,*)(*"1:eJxTTMoPSmNiYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCT4gEVxSmZPqkpqcX5RYkl+UyQMUguhiARJBpTmpwWxgVUWZeelgsZCi0lQAMqgWxw=="*)(*]BB*))(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KWlMIB4vkAjLTC13SU3OL0osyS8KBskHJOalQuRBvKDSnNRiTiDDMzcxPTU4syo1UwdoFAD3MhKy"*)(*]BB*)}(*||*),(*||*){"EstimateMaterialParameter"(*|*),(*|*)(*BB[*)((*BB[*)("EstimateMaterialParameter[parameter, response, thickness] estimates an optical property or FP-reduction score. EstimateMaterialParameter[] lists the supported parameters; Method selects Basic or Iterative extraction.")(*,*)(*"1:eJxTTMoPSmNiYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCT4gEVxSmZPqkpqcX5RYkl+UyQMUguhiARJBpTmpwWxgVUWZeelgsZCi0lQAMqgWxw=="*)(*]BB*))(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KWlMIB4vkAjLTC13SU3OL0osyS8KBskHJOalQuRBvKDSnNRiTiDDMzcxPTU4syo1UwdoFAD3MhKy"*)(*]BB*)}(*||*),(*||*){"FD2TD"(*|*),(*|*)(*BB[*)((*BB[*)("FD2TD[spectrum] returns a real time trace from a one-sided {frequency, magnitude, phase} spectrum. \"IncludeNyquist\" -> True expects a Nyquist bin; lists are processed elementwise.")(*,*)(*"1:eJxTTMoPSmNiYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCT4gEVxSmZPqkpqcX5RYkl+UyQMUguhiARJBpTmpwWxgVUWZeelgsZCi0lQAMqgWxw=="*)(*]BB*))(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KWlMIB4vkAjLTC13SU3OL0osyS8KBskHJOalQuRBvKDSnNRiTiDDMzcxPTU4syo1UwdoFAD3MhKy"*)(*]BB*)}(*||*),(*||*){"FrequencyDomainConfidenceInterval"(*|*),(*|*)(*BB[*)((*BB[*)("FrequencyDomainConfidenceInterval[input] estimates a usable frequency Interval from a time trace or spectrum. It returns inverse-centimeter endpoints; lists are processed elementwise.")(*,*)(*"1:eJxTTMoPSmNiYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCT4gEVxSmZPqkpqcX5RYkl+UyQMUguhiARJBpTmpwWxgVUWZeelgsZCi0lQAMqgWxw=="*)(*]BB*))(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KWlMIB4vkAjLTC13SU3OL0osyS8KBskHJOalQuRBvKDSnNRiTiDDMzcxPTU4syo1UwdoFAD3MhKy"*)(*]BB*)}(*||*),(*||*){"FrequencySpectrumTrim"(*|*),(*|*)(*BB[*)((*BB[*)("FrequencySpectrumTrim[input, interval] keeps only spectrum bins inside interval. Omitting interval uses FrequencyDomainConfidenceInterval; time traces are Fourier transformed first.")(*,*)(*"1:eJxTTMoPSmNiYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCT4gEVxSmZPqkpqcX5RYkl+UyQMUguhiARJBpTmpwWxgVUWZeelgsZCi0lQAMqgWxw=="*)(*]BB*))(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KWlMIB4vkAjLTC13SU3OL0osyS8KBskHJOalQuRBvKDSnNRiTiDDMzcxPTU4syo1UwdoFAD3MhKy"*)(*]BB*)}(*||*),(*||*){"GenerateMaterialResponse"(*|*),(*|*)(*BB[*)((*BB[*)("GenerateMaterialResponse[n, thickness, {interval, step}] generates a slab transmission spectrum. \nGenerateMaterialResponse[n, thickness, reference] returns the response in the reference domain; \"SolveFP\" and \"ConvolveWithReference\" control reflections and convolution.")(*,*)(*"1:eJxTTMoPSmNiYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCT4gEVxSmZPqkpqcX5RYkl+UyQMUguhiARJBpTmpwWxgVUWZeelgsZCi0lQAMqgWxw=="*)(*]BB*))(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KWlMIB4vkAjLTC13SU3OL0osyS8KBskHJOalQuRBvKDSnNRiTiDDMzcxPTU4syo1UwdoFAD3MhKy"*)(*]BB*)}(*||*),(*||*){"LinearProjectionsToCircular"(*|*),(*|*)(*BB[*)((*BB[*)("LinearProjectionsToCircular[trace1, trace2, {angle1, angle2}] reconstructs the two circular-polarization time traces from linear-analyzer measurements. Equal-length lists are processed pairwise.")(*,*)(*"1:eJxTTMoPSmNiYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCT4gEVxSmZPqkpqcX5RYkl+UyQMUguhiARJBpTmpwWxgVUWZeelgsZCi0lQAMqgWxw=="*)(*]BB*))(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KWlMIB4vkAjLTC13SU3OL0osyS8KBskHJOalQuRBvKDSnNRiTiDDMzcxPTU4syo1UwdoFAD3MhKy"*)(*]BB*)}(*||*),(*||*){"ResampleTraces"(*|*),(*|*)(*BB[*)((*BB[*)("ResampleTraces[trace] interpolates a time trace onto a uniform grid.\n ResampleTraces[{trace1, trace2, ...}] uses a common grid for all traces.")(*,*)(*"1:eJxTTMoPSmNiYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCT4gEVxSmZPqkpqcX5RYkl+UyQMUguhiARJBpTmpwWxgVUWZeelgsZCi0lQAMqgWxw=="*)(*]BB*))(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KWlMIB4vkAjLTC13SU3OL0osyS8KBskHJOalQuRBvKDSnNRiTiDDMzcxPTU4syo1UwdoFAD3MhKy"*)(*]BB*)}(*||*),(*||*){"TD2FD"(*|*),(*|*)(*BB[*)((*BB[*)("TD2FD[trace] returns a one-sided {frequency, magnitude, phase} spectrum from a time trace. \"IncludeNyquist\" -> True includes the Nyquist bin; lists are processed elementwise.")(*,*)(*"1:eJxTTMoPSmNiYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCT4gEVxSmZPqkpqcX5RYkl+UyQMUguhiARJBpTmpwWxgVUWZeelgsZCi0lQAMqgWxw=="*)(*]BB*))(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KWlMIB4vkAjLTC13SU3OL0osyS8KBskHJOalQuRBvKDSnNRiTiDDMzcxPTU4syo1UwdoFAD3MhKy"*)(*]BB*)}(*||*),(*||*){"TimeTraceQ"(*|*),(*|*)(*BB[*)((*BB[*)("TimeTraceQ[input] returns True for a time trace, False for a {frequency, magnitude, phase} spectrum, and $Failed for other inputs.")(*,*)(*"1:eJxTTMoPSmNiYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCT4gEVxSmZPqkpqcX5RYkl+UyQMUguhiARJBpTmpwWxgVUWZeelgsZCi0lQAMqgWxw=="*)(*]BB*))(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KWlMIB4vkAjLTC13SU3OL0osyS8KBskHJOalQuRBvKDSnNRiTiDDMzcxPTU4syo1UwdoFAD3MhKy"*)(*]BB*)}(*||*),(*||*){"ToStandardOpticsUnits"(*|*),(*|*)(*BB[*)((*BB[*)("ToStandardOpticsUnits[input] returns numeric data in picoseconds or terahertz from a compatible QuantityArray. Lists are processed elementwise.")(*,*)(*"1:eJxTTMoPSmNiYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCT4gEVxSmZPqkpqcX5RYkl+UyQMUguhiARJBpTmpwWxgVUWZeelgsZCi0lQAMqgWxw=="*)(*]BB*))(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KWlMIB4vkAjLTC13SU3OL0osyS8KBskHJOalQuRBvKDSnNRiTiDDMzcxPTU4syo1UwdoFAD3MhKy"*)(*]BB*)}(*||*),(*||*){"UnwrapPhase"(*|*),(*|*)(*BB[*)((*BB[*)("UnwrapPhase[input, interval] returns a full {frequency, magnitude, phase} spectrum with phase unwrapped inside interval. Omitting interval selects it automatically; linear phase is retained by default.")(*,*)(*"1:eJxTTMoPSmNiYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCT4gEVxSmZPqkpqcX5RYkl+UyQMUguhiARJBpTmpwWxgVUWZeelgsZCi0lQAMqgWxw=="*)(*]BB*))(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KWlMIB4vkAjLTC13SU3OL0osyS8KBskHJOalQuRBvKDSnNRiTiDDMzcxPTU4syo1UwdoFAD3MhKy"*)(*]BB*)}}(*||*)(*1:eJxTTMoPSmNmYGAo5gUSYZmp5S6py
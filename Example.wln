ListLinePlot[t // ToStandardOpticsUnits, Frame->True, PlotRange->Full, PlotRange->Full, FrameLabel->{"\[Tau] (ps)", "t(\[Tau])"}, PlotLabel->"Time-domain"]

TD2FD[t] //FrequencySpectrumTrim // ToStandardOpticsUnits;
